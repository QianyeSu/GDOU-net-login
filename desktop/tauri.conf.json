{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GDOU Net Login",
  "version": "0.1.10",
  "identifier": "cn.gdou.netlogin",
  "build": {
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build",
      "wait": true
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "广东海洋大学校园网助手",
        "width": 420,
        "height": 720,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
    "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyRDMwQjhDOEVCNEQ5RjAKUldUdzJiU09qQXZUZ3MxbCtUaHRHNndELzFKZkhGaGV2VkkyVVVoVHUvcUcxakxMT3dPSzJhNk0K",
      "endpoints": [
        "https://github.com/QianyeSu/GDOU-net-login/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

